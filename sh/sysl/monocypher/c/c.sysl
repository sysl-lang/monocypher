// Monocypher as C declares it.
//
// **Everything that is C lives in this directory** — the two `.c` files and their headers as they come
// from upstream, and this file of declarations over them. Nothing here is meant to be called by a
// program: every buffer is a bare pointer whose length the caller is trusted to have got right, and a
// verification answers `0` for *success*. The module above this one turns those into slices with
// `require`d lengths and into `bool`, and is what an application imports.
//
// The split keeps two jobs apart. This one has to be **faithful** — a signature that disagrees with the
// header links perfectly and corrupts the call at run time, which for a cryptographic library means
// reading past the end of a key or writing past the end of a signature, and nothing in this arrangement
// checks one against the other. So each declaration below was read out of `monocypher.h` and
// `monocypher-ed25519.h` rather than remembered. The other one has to be **pleasant**, which is a
// different question and would otherwise be answered in the same breath.
//
// **A fixed-size array parameter arrives here as a plain pointer, and that is the whole reason the
// layer above exists.** C writes `const uint8_t key[32]`, which is a pointer with a comment: the
// compiler checks nothing about it, and neither can sysl. The lengths are `require`d one level up,
// against the `const`s declared there.
//
// ==There is no shim, and the `c const` block is Argon2's alone==
//
// No shim, because every entry point takes scalars, pointers and small structs: Monocypher is written
// to need no allocator, no operating system and no C library, and it publishes nothing whose layout
// has to be hidden from a caller using the one-shot functions.
//
// **The sizes are not asked for, because `monocypher.h` does not define them.** They are written into
// the array parameters — `key[32]`, `signature[64]` — where they are documentation to a reader and
// nothing at all to the compiler. So the sizes stay `const`s in the module above, taken from the
// algorithms' own specifications: X25519 keys are 32 bytes because Curve25519 is a 255-bit curve, not
// because a header says so. That is the same case as st7796's datasheet command bytes, and the
// opposite of qcbor's or termbox2's `#define`s.
//
// **This paragraph read "there is no `c const`" until Argon2 was bound.** The header's only `#define`s
// are Argon2's three variant numbers, and while Argon2 was unbound there was nothing for the C
// compiler to be asked — so the absence was a finding about the library rather than an omission. It is
// still that; there is simply an Argon2 now, and its three constants are read rather than copied.

module sh.sysl.monocypher.c

@include("monocypher.h")
@include("monocypher-ed25519.h")

extern "crypto_blake2b" blake2b(hash: *u8, hash_size: usize, message: *u8, message_size: usize)
extern "crypto_blake2b_keyed" blake2b_keyed(hash: *u8, hash_size: usize, key: *u8, key_size: usize,
                                              message: *u8, message_size: usize)

extern "crypto_aead_lock" aead_lock(cipher: *u8, mac: *u8, key: *u8, nonce: *u8,
                                      ad: *u8, ad_size: usize, plain: *u8, text_size: usize)
extern "crypto_aead_unlock" aead_unlock(plain: *u8, mac: *u8, key: *u8, nonce: *u8,
                                          ad: *u8, ad_size: usize, cipher: *u8,
                                          text_size: usize) -> int

extern "crypto_x25519_public_key" x25519_public_key(public_key: *u8, secret_key: *u8)
extern "crypto_x25519" x25519(shared: *u8, your_secret: *u8, their_public: *u8)

extern "crypto_eddsa_key_pair" eddsa_key_pair(secret_key: *u8, public_key: *u8, seed: *u8)
extern "crypto_eddsa_sign" eddsa_sign(signature: *u8, secret_key: *u8, message: *u8,
                                        message_size: usize)
extern "crypto_eddsa_check" eddsa_check(signature: *u8, public_key: *u8, message: *u8,
                                          message_size: usize) -> int

extern "crypto_sha512" sha512(hash: *u8, message: *u8, message_size: usize)

extern "crypto_ed25519_key_pair" ed25519_key_pair(secret_key: *u8, public_key: *u8, seed: *u8)
extern "crypto_ed25519_sign" ed25519_sign(signature: *u8, secret_key: *u8, message: *u8,
                                            message_size: usize)
extern "crypto_ed25519_check" ed25519_check(signature: *u8, public_key: *u8, message: *u8,
                                              message_size: usize) -> int

extern "crypto_verify16" verify16(a: *u8, b: *u8) -> int
extern "crypto_verify32" verify32(a: *u8, b: *u8) -> int
extern "crypto_verify64" verify64(a: *u8, b: *u8) -> int

extern "crypto_wipe" wipe(secret: *u8, size: usize)

// ## Argon2
//
// **Three structs crossing by value**, which is ordinary and is worth saying only because a comment in
// this package once claimed the opposite: `qcbor.sysl` recorded that "a struct passed by value has no
// sysl spelling", the org file quoted it as a language limit, and it was never true. The layouts here
// are checked against C's own `sizeof` in the tests beside this file rather than trusted.
//
// The `algorithm` field takes one of the three constants below; every other field is a count.
struct Argon2Config
    algorithm: u32
    nb_blocks: u32
    nb_passes: u32
    nb_lanes: u32

// **A null `pass` or `salt` is not allowed** — Argon2 hashes both and neither may be absent, unlike
// the two fields of `Argon2Extras`.
struct Argon2Inputs
    pass: *u8
    salt: *u8
    pass_size: u32
    salt_size: u32

// Both pointers may be null with their size zero, which is what `crypto_argon2_no_extras` is. That
// variable is not bound: a zeroed value of this struct is the same thing and needs no symbol.
struct Argon2Extras
    key: *u8
    ad: *u8
    key_size: u32
    ad_size: u32

// `work_area` must be `nb_blocks * 1024` bytes and is scribbled over. Nothing is allocated: this is
// the caller-supplied-storage shape, which is why the module above can still claim no capabilities.
extern "crypto_argon2" argon2(hash: *u8, hash_size: u32, work_area: *u8,
                              config: Argon2Config, inputs: Argon2Inputs, extras: Argon2Extras)

// The header's only `#define`s, read rather than copied — which matters more than it looks, since the
// three are 0, 1 and 2 and a transcription that shifted them by one would compute a real Argon2 of the
// wrong variant and look entirely healthy.
c const
    ARGON2_D:  u32 = "CRYPTO_ARGON2_D"
    ARGON2_I:  u32 = "CRYPTO_ARGON2_I"
    ARGON2_ID: u32 = "CRYPTO_ARGON2_ID"

// What C says these are, so that a Monocypher release which changed one fails a test rather than
// corrupting a call.
c const
    CONFIG_SIZE: usize = "sizeof(crypto_argon2_config)"
    INPUTS_SIZE: usize = "sizeof(crypto_argon2_inputs)"
    EXTRAS_SIZE: usize = "sizeof(crypto_argon2_extras)"
