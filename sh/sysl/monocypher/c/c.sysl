// Monocypher as C declares it.
//
// **Everything that is C lives in this directory** — the two `.c` files and their headers as they come
// from upstream, and this file of declarations over them. Nothing here is meant to be called by a
// program: every buffer is a bare pointer whose length the caller is trusted to have got right, and a
// verification answers `0` for *success*. The module above this one turns those into slices with
// `require`d lengths and into `bool`, and is what an application imports.
//
// The split keeps two jobs apart. This one has to be **faithful** — a signature that disagrees with the
// header links perfectly and corrupts the call at run time, which for a cryptographic library means
// reading past the end of a key or writing past the end of a signature, and nothing in this arrangement
// checks one against the other. So each declaration below was read out of `monocypher.h` and
// `monocypher-ed25519.h` rather than remembered. The other one has to be **pleasant**, which is a
// different question and would otherwise be answered in the same breath.
//
// **A fixed-size array parameter arrives here as a plain pointer, and that is the whole reason the
// layer above exists.** C writes `const uint8_t key[32]`, which is a pointer with a comment: the
// compiler checks nothing about it, and neither can sysl. The lengths are `require`d one level up,
// against the `const`s declared there.
//
// ==There is no shim, and no `c const` — and the second one is a finding rather than an omission==
//
// No shim, because every entry point takes scalars and pointers: Monocypher is written to need no
// allocator, no operating system and no C library, and it publishes nothing whose layout has to be
// hidden from a caller using the one-shot functions.
//
// **No `c const`, because `monocypher.h` does not define the sizes.** They are written into the array
// parameters — `key[32]`, `signature[64]` — where they are documentation to a reader and nothing at all
// to the compiler. The only `#define`s in either header are Argon2's three variants, and this binding
// does not bind Argon2. So there is nothing for the C compiler to be asked, and the sizes stay
// `const`s in the module above, taken from the algorithms' own specifications: X25519 keys are 32 bytes
// because Curve25519 is a 255-bit curve, not because a header says so. That is the same case as
// st7796's datasheet command bytes, and the opposite of qcbor's or termbox2's `#define`s.

module sh.sysl.monocypher.c

@include("monocypher.h")
@include("monocypher-ed25519.h")

extern "crypto_blake2b" blake2b(hash: *u8, hash_size: usize, message: *u8, message_size: usize)
extern "crypto_blake2b_keyed" blake2b_keyed(hash: *u8, hash_size: usize, key: *u8, key_size: usize,
                                              message: *u8, message_size: usize)

extern "crypto_aead_lock" aead_lock(cipher: *u8, mac: *u8, key: *u8, nonce: *u8,
                                      ad: *u8, ad_size: usize, plain: *u8, text_size: usize)
extern "crypto_aead_unlock" aead_unlock(plain: *u8, mac: *u8, key: *u8, nonce: *u8,
                                          ad: *u8, ad_size: usize, cipher: *u8,
                                          text_size: usize) -> int

extern "crypto_x25519_public_key" x25519_public_key(public_key: *u8, secret_key: *u8)
extern "crypto_x25519" x25519(shared: *u8, your_secret: *u8, their_public: *u8)

extern "crypto_eddsa_key_pair" eddsa_key_pair(secret_key: *u8, public_key: *u8, seed: *u8)
extern "crypto_eddsa_sign" eddsa_sign(signature: *u8, secret_key: *u8, message: *u8,
                                        message_size: usize)
extern "crypto_eddsa_check" eddsa_check(signature: *u8, public_key: *u8, message: *u8,
                                          message_size: usize) -> int

extern "crypto_sha512" sha512(hash: *u8, message: *u8, message_size: usize)

extern "crypto_ed25519_key_pair" ed25519_key_pair(secret_key: *u8, public_key: *u8, seed: *u8)
extern "crypto_ed25519_sign" ed25519_sign(signature: *u8, secret_key: *u8, message: *u8,
                                            message_size: usize)
extern "crypto_ed25519_check" ed25519_check(signature: *u8, public_key: *u8, message: *u8,
                                              message_size: usize) -> int

extern "crypto_verify16" verify16(a: *u8, b: *u8) -> int
extern "crypto_verify32" verify32(a: *u8, b: *u8) -> int
extern "crypto_verify64" verify64(a: *u8, b: *u8) -> int

extern "crypto_wipe" wipe(secret: *u8, size: usize)
